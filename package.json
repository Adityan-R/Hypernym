{
  "name": "@superset/repo",
  "version": "0.0.0",
  "repository": {
    "type": "git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/bun": "1.3.14",
    "@types/semver": "7.7.1",
    "dotenv-cli": "11.0.0",
    "semver": "7.7.4",
    "sherif": "1.11.0",
    "turbo": "2.9.14",
    "typescript": "6.0.3"
  },
  "description": "Superset Monorepo",
  "homepage": "https://superset.sh",
  "license": "Elastic-2.0",
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@superset/api --filter=@superset/web --filter=@superset/desktop --filter=electric-proxy",
    "dev:all": "turbo dev --concurrency=15",
    "dev:desktop": "turbo run dev --filter=@superset/api --filter=@superset/desktop --filter=electric-proxy",
    "dev:caddy": "dotenv -- caddy run --config Caddyfile",
    "dev:docs": "turbo dev --filter=@superset/docs",
    "dev:marketing": "turbo dev --filter=@superset/marketing --filter=@superset/docs",
    "dev:relay": "turbo dev --filter=@superset/relay",
    "build": "turbo build --filter=@superset/desktop",
    "test": "turbo test --concurrency=2",
    "lint": "./scripts/lint.sh",
    "check:desktop-git-env": "./scripts/check-desktop-git-env.sh",
    "lint:fix": "bunx @biomejs/biome@2.4.2 migrate --write && bunx @biomejs/biome@2.4.2 check --write --unsafe .",
    "format": "bunx @biomejs/biome@2.4.2 format --write .",
    "format:check": "bunx @biomejs/biome@2.4.2 format .",
    "typecheck": "turbo typecheck",
    "ui-add": "turbo run ui-add",
    "postinstall": "bun run ./scripts/postinstall.ts",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "release": "bun scripts/release/release.ts",
    "release:desktop": "bun scripts/release/desktop.ts",
    "release:cli": "bun scripts/release/cli.ts",
    "release:canary": "./scripts/release-canary.sh",
    "check:versions": "bun scripts/release/check-versions.ts",
    "typecheck:release": "tsc -p scripts/release/tsconfig.json",
    "test:release": "bun test scripts/release",
    "db:push": "bun run --cwd packages/db push",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:seed-dev": "NODE_ENV=development bun run packages/auth/src/seed-dev.ts",
    "db:generate:desktop": "bun run --cwd packages/local-db generate"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "overrides": {
    "axios": "1.14.0",
    "hono": "4.12.25",
    "kysely": "0.28.17",
    "shell-quote": "1.8.4",
    "is-stream": "4.0.1"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "bufferutil",
    "electron",
    "esbuild",
    "koffi",
    "node-pty",
    "sharp",
    "utf-8-validate",
    "workerd"
  ],
  "dependencies": {
    "@ai-sdk/provider-utils-v5": "npm:@ai-sdk/provider-utils@3.0.25",
    "@ai-sdk/provider-utils-v6": "npm:@ai-sdk/provider-utils@4.0.27",
    "@ai-sdk/provider-v5": "npm:@ai-sdk/provider@2.0.3",
    "@ai-sdk/provider-v6": "npm:@ai-sdk/provider@3.0.10",
    "@ai-sdk/ui-utils-v5": "npm:@ai-sdk/ui-utils@1.2.11",
    "@ai-sdk/anthropic-v5": "npm:@ai-sdk/anthropic@2.0.79",
    "@ai-sdk/anthropic-v6": "npm:@ai-sdk/anthropic@3.0.76",
    "@ai-sdk/cerebras-v5": "npm:@ai-sdk/cerebras@1.0.44",
    "@ai-sdk/deepinfra-v5": "npm:@ai-sdk/deepinfra@1.0.42",
    "@ai-sdk/deepseek-v5": "npm:@ai-sdk/deepseek@1.0.40",
    "@ai-sdk/google-v5": "npm:@ai-sdk/google@2.0.72",
    "@ai-sdk/google-v6": "npm:@ai-sdk/google@3.0.70",
    "@ai-sdk/groq-v5": "npm:@ai-sdk/groq@2.0.40",
    "@ai-sdk/groq-v6": "npm:@ai-sdk/groq@3.0.39",
    "@ai-sdk/mistral-v5": "npm:@ai-sdk/mistral@2.0.33",
    "@ai-sdk/mistral-v6": "npm:@ai-sdk/mistral@3.0.36",
    "@ai-sdk/openai-compatible-v5": "npm:@ai-sdk/openai-compatible@1.0.39",
    "@ai-sdk/openai-v5": "npm:@ai-sdk/openai@2.0.106",
    "@ai-sdk/openai-v6": "npm:@ai-sdk/openai@3.0.63",
    "@ai-sdk/perplexity-v5": "npm:@ai-sdk/perplexity@2.0.30",
    "@ai-sdk/provider-utils-v4": "npm:@ai-sdk/provider-utils@2.2.8",
    "@ai-sdk/provider-v4": "npm:@ai-sdk/provider@1.1.3",
    "@ai-sdk/togetherai-v5": "npm:@ai-sdk/togetherai@1.0.42",
    "@ai-sdk/xai-v5": "npm:@ai-sdk/xai@2.0.72",
    "@ai-sdk/xai-v6": "npm:@ai-sdk/xai@3.0.89",
    "@openrouter/ai-sdk-provider-v5": "npm:@openrouter/ai-sdk-provider@1.2.3"
  }
}
